// * HK - Git Hook Configuration
// This file ensures you are committing properly linted and formatted files which will pass ci
amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

import "generated/generated.pkl"

steps = generated.addSteps((generated.steps) {
  ["[fix] taskfile generated"] {
    glob = List("taskfile/scripts/*.sh", "taskfile/*.yml", "scripts/generate_taskfile.sh")
    check = "scripts/generate_taskfile.sh --check"
    fix = "scripts/generate_taskfile.sh"
  }
  ["[lint] copy-paste"] {
    exclude = List("taskfile/taskfile.yml")
  }
})
